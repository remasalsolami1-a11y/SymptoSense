# Core production configuration
# REQUIRED on Railway: PostgreSQL connection string. SQLite is local-development only.
DATABASE_URL=
# REQUIRED on Railway: stable random secret, minimum 32 characters.
WEB_SECRET=
# Stable high-entropy secret used for pseudonymous user hashes and legacy hash
# compatibility. Set once per deployment and do not rotate without migration.
HASH_SALT=
SITE_URL=https://your-domain.example
# Optional explicit Host allow-list (SITE_URL + Railway public domain are auto-added).
TRUSTED_HOSTS=your-domain.example,www.your-domain.example
SESSION_COOKIE_SECURE=1
# REQUIRED for automatic owner bootstrap/recovery. Never commit a real address.
SYMPTOSENSE_ADMIN_EMAIL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL_FALLBACK=qwen/qwen3.8-27b
VOICE_STT_MODEL=whisper-large-v3-turbo

# Optional privacy-first production error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Authentication email (Brevo)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=SymptoSense

# Medication reminder email uses Brevo or Resend.
# Brevo variables above are sufficient. Alternatively configure Resend:
RESEND_API_KEY=
RESEND_FROM=SymptoSense <reminders@your-domain.example>
# Railway Cron for medication reminders (configure in Railway, not as env vars):
# Command: python medication_email_job.py
# Schedule: * * * * *

# Require TOTP 2FA for the Admin account (recommended in production)
ADMIN_2FA_REQUIRED=1

# Release candidate / reproducible research
APP_VERSION=268.0.0
RELEASE_CANDIDATE_ID=SymptoSense-v268
RELEASE_CHANNEL=final
FEATURE_FREEZE=1
RESEARCH_STUDY_VERSION=SS-RV-1.0

# Security hardening
# Maximum JSON API body size; file uploads use MAX_CONTENT_LENGTH separately.
MAX_API_JSON_BYTES=262144
BLOOD_UPLOAD_MAX_BYTES=15728640
VOICE_UPLOAD_MAX_BYTES=8388608
# Opt-in migration check: reports inline-script CSP violations without blocking the UI.
CSP_STRICT_REPORT_ONLY=0
ADMIN_SESSION_TIMEOUT_MINUTES=30
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
ASSISTANT_RATE_LIMIT_MAX=40
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=300
ANALYZE_RATE_LIMIT_MAX=20
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=300
VOICE_RATE_LIMIT_MAX=12
VOICE_RATE_LIMIT_WINDOW_SECONDS=300
BLOOD_RATE_LIMIT_MAX=10
BLOOD_RATE_LIMIT_WINDOW_SECONDS=300
HOSPITALS_RATE_LIMIT_MAX=12
HOSPITALS_RATE_LIMIT_WINDOW_SECONDS=300

# Data retention (0 = user-controlled / no automatic health-record expiry)
HEALTH_DATA_RETENTION_DAYS=0
USAGE_ANALYTICS_RETENTION_DAYS=180
SECURITY_LOG_RETENTION_DAYS=90
RATE_LIMIT_RETENTION_DAYS=2
MEDICATION_EMAIL_RETENTION_DAYS=90
EXPIRED_TOKEN_RETENTION_DAYS=7
EXPIRED_HANDOFF_RETENTION_DAYS=7

# Medication reminder scheduler
# Create a Railway Cron job that runs once per minute:
#   python medication_email_job.py
# Cron expression: * * * * *

# Encrypted application-level database backups (attach a persistent Volume)
BACKUP_SCHEDULER_ENABLED=0
BACKUP_DIR=/data/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=7
BACKUP_MAX_AGE_HOURS=30
RESTORE_TEST_DATABASE_URL=
RESTORE_TEST_MAX_AGE_DAYS=14

# Destructive pre-launch cleanup is disabled by default. Enable temporarily only when needed.
ALLOW_LAUNCH_RESET=0

# Maximum number of pages read from an uploaded CBC PDF (bounded for cost/safety)
CBC_MAX_PDF_PAGES=5

# V47 platform capabilities
# Optional Redis/RQ. Without REDIS_URL, bounded local background workers are used.
REDIS_URL=
LOCAL_JOB_WORKERS=2

# WebAuthn / Passkeys (SITE_URL is used automatically when these are blank)
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# V47 feature flags (1=enabled, 0=disabled)
FEATURE_SYMPTOM_ENGINE_V2=1
FEATURE_SEARCH_ENGINE_V2=1
FEATURE_FHIR_EXPORT=1
FEATURE_PASSKEYS=1
FEATURE_SOURCE_MONITOR=1
FEATURE_BACKGROUND_JOBS=1
FEATURE_API_V1=1
FEATURE_REQUEST_TRACING=1

# Optional Telegram layer for medication reminders (email always remains enabled)
# Create one bot via @BotFather, then run: python configure_telegram_bot.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Official medical-source review pipeline (never auto-publishes)
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE=2026-01
NHS_CONTENT_API_KEY=
NHS_CONTENT_API_BASE=https://api.service.nhs.uk/nhs-website-content

# V177 — optional content-priority inputs (Admin/editorial only)
# Search Console uses an OAuth access token with permission to the configured property.
GSC_ACCESS_TOKEN=
GSC_SITE_URL=https://symptosensehealth.com/
# Google Trends is imported from an exported CSV in Admin; no unofficial scraper/API is used.
ICD_BACKFILL_LIMIT=100

# V216 runtime isolation / concurrency
WEB_THREADS=12
POSTGRES_POOL_MAX=16
SLOW_REQUEST_LOG_MS=2500
# Keep heavy maintenance out of the request-serving process. Run via Railway cron/worker.
RETENTION_HOUSEKEEPING_IN_WEB=0
BACKUP_SCHEDULER_IN_WEB=0

# Trusted medication fallback: local catalog first, then RxNorm/openFDA on a miss.
EXTERNAL_DRUG_LOOKUP_ENABLED=1
EXTERNAL_DRUG_LOOKUP_TIMEOUT_SECONDS=2.8
# Arabic external-label translation/summary (source-grounded; no dosing advice)
DRUG_ARABIC_SUMMARY_ENABLED=1
DRUG_ARABIC_SUMMARY_TIMEOUT_SECONDS=5.0
# Optional but recommended for regular openFDA traffic.
OPENFDA_API_KEY=
